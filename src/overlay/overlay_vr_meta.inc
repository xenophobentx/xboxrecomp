/* The VR settings' labels and hints, included inside the k_meta[] initialiser of overlay_ui.cpp, in xbox_settings_vr_ids.inc's order. */
    /* XS_VR_IPD */ { XS_VR_IPD, "Eye separation", "The distance between the two eyes' cameras, in millimetres. Set it to your own (the headset's IPD setting shows it): 64 is the average.", 1, FMT_MM, NULL, 0 },
    /* XS_VR_NEAR */ { XS_VR_NEAR, "Near plane", "How close to the eyes things stop being drawn, in millimetres. Smaller shows the dashboard and wheel arms up close; too small and the picture's depth flickers.", 10, FMT_MM, NULL, 0 },
    /* XS_VR_FOV */ { XS_VR_FOV, "Headset field of view", "On: the picture uses the headset's own field of view. Off: the game's (about 106 by 74 degrees), with black around it.", 1, FMT_PLAIN, NULL, 0 },
    /* XS_VR_MENU_ASPECT */ { XS_VR_MENU_ASPECT, "Menu screen shape", "The shape of the flat screen (the cinema view) the menus, crash views and replays are shown on in the headset: width over height. Shows at once.", 0.05, FMT_PLAIN, NULL, 0 },
    /* XS_VR_HIDE_DRIVER */ { XS_VR_HIDE_DRIVER, "Hide the driver", "Hides the driver's figure, which can sit in front of the eyes in the seat view.", 1, FMT_PLAIN, NULL, 0 },
    /* XS_VR_BOOSTFX */ { XS_VR_BOOSTFX, "Boost effect", "The speed streaks and blur while boosting. Off if they are uncomfortable in the headset.", 1, FMT_PLAIN, NULL, 0 },
    /* XS_VR_KEEP_FX */ { XS_VR_KEEP_FX, "Bloom and motion blur", "On keeps the game's bloom and motion blur in the headset picture (it may come out brighter). Off, the default, turns them off for it.", 1, FMT_PLAIN, NULL, 0 },
    /* XS_VR_ASPECT_X */ { XS_VR_ASPECT_X, "Picture width (car)", "Stretches (+) or squeezes (-) the headset picture sideways, in percent, on top of the display aspect and ultrawide settings. 0 is as the game draws it. Changes show at once: adjust until a round thing (a wheel, a roundel) looks round.", 1, FMT_RAWPCT, NULL, 0 },
    /* XS_VR_ASPECT_Y */ { XS_VR_ASPECT_Y, "Picture height (car)", "Stretches (+) or squeezes (-) the headset picture up and down, in percent. 0 is as the game draws it. Changes show at once.", 1, FMT_RAWPCT, NULL, 0 },
    /* XS_VR_SCREEN_X */ { XS_VR_SCREEN_X, "Flat screen width", "Stretches (+) or squeezes (-) the flat screen (menus, crash views, replays) sideways, in percent, after its shape above. 0 is as set. Shows at once.", 1, FMT_RAWPCT, NULL, 0 },
    /* XS_VR_SCREEN_Y */ { XS_VR_SCREEN_Y, "Flat screen height", "Stretches (+) or squeezes (-) the flat screen up and down, in percent. 0 is as set. Shows at once.", 1, FMT_RAWPCT, NULL, 0 },
    /* XS_VR_SCALE */ { XS_VR_SCALE, "Render scale", "The internal resolution in the headset, as a multiple of the Xbox's 640x480 (each eye gets half the frame's width). 8 is the sharpest and the heaviest. Used in VR instead of the Graphics page's.", 1, FMT_TIMES, NULL, 0 },
    /* XS_VR_AA */ { XS_VR_AA, "Anti-aliasing", "Smooths jagged edges in the headset. SMAA is the cleanest. Used in VR instead of the Graphics page's.", 1, FMT_PLAIN, n_aa, 0 },
    /* XS_VR_SHARPEN */ { XS_VR_SHARPEN, "Sharpening", "Sharpening in the headset. 0 is best for a supersampled picture (sharpening makes it shimmer and look pixelated). Used in VR instead of the Graphics page's.", 0.05, FMT_PERCENT, NULL, 0 },
    /* XS_VR_LOD_BIAS */ { XS_VR_LOD_BIAS, "Texture sharpness (LOD bias)", "Picks sharper texture levels. Off is smoother in the headset. Used in VR instead of the Graphics page's.", 1, FMT_PLAIN, n_lod, 0 },
    /* XS_VR_API */ { XS_VR_API, "Graphics API", "How the picture reaches the headset. Direct3D 11 is the one that works. Vulkan is experimental: SteamVR crashed with it on the development PC when the headset started. If VR does not start, start the game without --vr, set this back and restart.", 1, FMT_PLAIN, n_vrapi, 0 },
